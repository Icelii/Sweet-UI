/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@core/interfaces/*": ["./src/app/core/interfaces/*"],
      "@core/services/*": ["./src/app/core/services/*"],
      "@core/navigation/*": ["./src/app/core/navigation/*"],
      "@core/i18n/*": ["./src/app/core/i18n/*"],
      "@core/config/*": ["./src/app/core/config/*"],
      "@shared/components/*": ["./src/app/shared/components/*"],
      "@shared/pipes/*": ["./src/app/shared/pipes/*"],
      "@shared/directives/*": ["./src/app/shared/directives/*"],
      "@shared/validators/*": ["./src/app/shared/validators/*"],
      "@shared/utils/*": ["./src/app/shared/utils/*"],
      "@layouts/main-layout/*": ["./src/app/layouts/main-layout/*"],
      "@layouts/auth-layout/*": ["./src/app/layouts/auth-layout/*"],
      "@layouts/profile-config-layout/*": ["./src/app/layouts/profile-config-layout/*"],
      "@features/auth/*": ["./src/app/features/auth/*"],
      "@features/not-found/*": ["./src/app/features/not-found/*"],
      "@features/dashboard/*": ["./src/app/features/dashboard/*"],
      "@features/profile/*": ["./src/app/features/profile/*"],
      "@features/ui/*": ["./src/app/features/ui/*"],
      "@features/chat/*": ["./src/app/features/chat/*"],
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}